{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSM Evolved",
  "mainBinaryName": "JSM Evolved",
  "version": "0.7.157",
  "identifier": "com.lukeybeachboy.jsmstudio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:drivers && npm run build:joyshockmapper && npm run build:sidecars && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSM Evolved",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "publisher": "Luke Beach",
    "shortDescription": "Controller configuration and gyro aiming with JoyShockMapper",
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "bin": "bin",
      "third_party/HidHide": "third_party/HidHide",
      "third_party/ViGEmBus/ViGEmBus_1.22.0_x64_x86_arm64.exe": "third_party/ViGEmBus/ViGEmBus_1.22.0_x64_x86_arm64.exe",
      "third_party/ViGEmBus/README.md": "third_party/ViGEmBus/README.md",
      "third_party/FakerInput": "third_party/FakerInput"
    },
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "languages": ["English"],
        "customLanguageFiles": { "English": "installer-English.nsh" },
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
