{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JSM Studio",
  "mainBinaryName": "JSM Studio",
  "version": "0.7.13",
  "identifier": "com.lukeybeachboy.jsmstudio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run prepare:drivers && npm run build:joyshockmapper && npm run build:sidecars && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JSM Studio",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "bin": "bin",
      "third_party/HidHide": "third_party/HidHide",
      "third_party/ViGEmBus/ViGEmBus_1.22.0_x64_x86_arm64.exe": "third_party/ViGEmBus/ViGEmBus_1.22.0_x64_x86_arm64.exe",
      "third_party/ViGEmBus/README.md": "third_party/ViGEmBus/README.md"
    },
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
